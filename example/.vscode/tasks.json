{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set Env for Dev",
      "type": "shell",
      "command": "moshaf_boilerplate",
      "args": [
        "env",
        "dev"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Set Env for Staging",
      "type": "shell",
      "command": "moshaf_boilerplate",
      "args": [
        "env",
        "staging"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Set Env for Prod",
      "type": "shell",
      "command": "moshaf_boilerplate",
      "args": [
        "env",
        "prod"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Regenerate Assets",
      "type": "shell",
      "command": "moshaf_boilerplate",
      "args": [
        "assets"
      ],
      "group": "build"
    }
  ]
}
