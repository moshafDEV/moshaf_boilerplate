# Copied to .env by `moshaf_boilerplate pre_launch_task prod` — see env.dart
# for what each key does. Placeholder values only — replace with your real
# production values, and prefer your team's secret store over committing
# real ones here once this stops being a placeholder.
#
# DEVELOPER_PIN gates the developer-tools unlock in production (see
# developer_pin_gate.dart). Left empty, the tap-7-times gesture alone is
# enough to unlock — set a PIN here if you want a second factor in prod.
APP_NAME=ProjectDisplayName
API_URL=https://api.example.com
ENABLE_FIREBASE=false
DEVELOPER_PIN=
